{
  "model": "vggts",
  "environment": "/opt/conda/envs/vggts",
  "repo": "/root/VGGT-S-main",
  "vggt_checkpoint": "/root/VGGT-S-main/third_party/vggt_main/model.pt",
  "checkpoint": null,
